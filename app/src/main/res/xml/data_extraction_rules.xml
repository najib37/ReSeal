<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. The database holds cookie profiles (login sessions), so it is never backed up or transferred. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="app_database" />
        <exclude domain="database" path="app_database-shm" />
        <exclude domain="database" path="app_database-wal" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="app_database" />
        <exclude domain="database" path="app_database-shm" />
        <exclude domain="database" path="app_database-wal" />
    </device-transfer>
</data-extraction-rules>
