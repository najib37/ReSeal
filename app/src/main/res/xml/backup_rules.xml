<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and lower. The database holds cookie profiles (login sessions), so it is never backed up. -->
<full-backup-content>
    <exclude domain="database" path="app_database" />
    <exclude domain="database" path="app_database-shm" />
    <exclude domain="database" path="app_database-wal" />
    <!-- MMKV preferences: the proxy URL can embed credentials, and the task backup holds URLs -->
    <exclude domain="file" path="mmkv/" />
</full-backup-content>
